// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Prisma Schema â€” YoyoSMM Full Database
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ USER â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model User {
  id              String   @id @default(cuid())
  supabaseId      String   @unique @map("supabase_id")
  email           String   @unique
  name            String?
  avatarUrl       String?  @map("avatar_url")
  plan            Plan     @default(FREE)
  trialEndsAt     DateTime? @map("trial_ends_at")
  lifetimeUnlocked Boolean @default(false) @map("lifetime_unlocked")
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  walletMode       Boolean  @default(false) @map("wallet_mode")
  balance          Float    @default(0.0)
  referredBy       String?  @map("referred_by")
  affiliateCode    String?  @unique @map("affiliate_code")
  affiliateClicks  Int      @default(0) @map("affiliate_clicks")
  affiliateEarnings Float   @default(0.0) @map("affiliate_earnings")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  panels          Panel[]
  reels           Reel[]
  orders          Order[]
  subscription    Subscription?
  auditLogs       AuditLog[]
  cryptoPayments  CryptoPayment[]
  serviceConfigs  ServiceConfig[]
  curveTemplates  CurveTemplate[]
  upiPayments     UpiPayment[]
  supportTickets  SupportTicket[]
  affiliateTx     AffiliateTransaction[] @relation("AffiliateEarnings")
  referredTx      AffiliateTransaction[] @relation("ReferredUser")
  autoSubscriptions AutoSubscription[]

  @@map("users")
}

enum Plan {
  FREE
  TRIAL
  LIFETIME
  SUSPENDED
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ SMM PANEL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Panel {
  id              String   @id @default(cuid())
  userId          String?  @map("user_id")
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  apiUrl          String   @map("api_url")
  apiKeyEncrypted String   @map("api_key_encrypted") // AES-256 encrypted
  priority        Int      @default(1)
  loadPercentage  Int      @default(100) @map("load_percentage")
  isActive        Boolean  @default(true) @map("is_active")

  // Service IDs per platform per engagement type
  // { "instagram": { "views": "1234", "likes": "5678", "saves": "9012", "shares": "3456", "comments": "7890" }, "tiktok": { ... } }
  serviceIds      Json?    @map("service_ids")

  // Health metrics
  lastCheckedAt   DateTime? @map("last_checked_at")
  lastResponseMs  Int?      @map("last_response_ms")
  successRate     Float     @default(100.0) @map("success_rate")
  status          PanelStatus @default(UNKNOWN)

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  orders          Order[]
  deliveryEvents  DeliveryEvent[]
  serviceConfigs  ServiceConfig[]
  adminServices   AdminService[]
  serviceChangeLogs ServiceChangeLog[]

  @@map("panels")
}

enum PanelStatus {
  ONLINE
  OFFLINE
  SLOW
  UNKNOWN
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ REEL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Reel {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  url             String
  platform        Platform
  title           String?
  thumbnailUrl    String?  @map("thumbnail_url")
  status          ReelStatus @default(ACTIVE)

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  orders          Order[]

  @@map("reels")
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  TELEGRAM
  FACEBOOK
  TWITTER
}

enum ReelStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ ORDER â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Order {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reelId          String   @map("reel_id")
  reel            Reel     @relation(fields: [reelId], references: [id])
  panelId         String?  @map("panel_id")
  panel           Panel?   @relation(fields: [panelId], references: [id], onDelete: SetNull)

  // View targets
  viewsTarget       Int      @map("views_target")
  viewsDelivered    Int      @default(0) @map("views_delivered")
  viewsRemaining    Int      @map("views_remaining")

  // Engagement targets (auto-calculated from ratios)
  engagementEnabled   Boolean  @default(true) @map("engagement_enabled")
  likesTarget         Int      @default(0) @map("likes_target")
  savesTarget         Int      @default(0) @map("saves_target")
  sharesTarget        Int      @default(0) @map("shares_target")
  commentsTarget      Int      @default(0) @map("comments_target")
  repostsTarget       Int      @default(0) @map("reposts_target")
  likesDelivered      Int      @default(0) @map("likes_delivered")
  savesDelivered      Int      @default(0) @map("saves_delivered")
  sharesDelivered     Int      @default(0) @map("shares_delivered")
  commentsDelivered   Int      @default(0) @map("comments_delivered")
  repostsDelivered    Int      @default(0) @map("reposts_delivered")
  // Ratios stored as percentages e.g. 4.0 = 4%
  likesRatioPct       Float    @default(4.0) @map("likes_ratio_pct")
  savesRatioPct       Float    @default(2.0) @map("saves_ratio_pct")
  sharesRatioPct      Float    @default(0.5) @map("shares_ratio_pct")
  commentsRatioPct    Float    @default(0.2) @map("comments_ratio_pct")
  repostsRatioPct     Float    @default(0.0) @map("reposts_ratio_pct")

  // Curve config
  curveStyle        CurveStyle @default(ORGANIC) @map("curve_style")
  durationHours     Int      @default(24) @map("duration_hours")
  warmupHours       Int      @default(4) @map("warmup_hours")
  peakHours         Int      @default(8) @map("peak_hours")
  decayHours        Int      @default(12) @map("decay_hours")

  // Panel order tracking
  panelOrderId      String?  @map("panel_order_id")
  panelServiceId    String?  @map("panel_service_id")

  status          OrderStatus @default(PENDING)
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  failReason      String?  @map("fail_reason")

  priceCharged      Float    @default(0.0) @map("price_charged")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  deliveryEvents  DeliveryEvent[]

  @@map("orders")
}

