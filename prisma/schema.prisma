enum OrderStatus {
  PENDING
  QUEUED
  DELIVERING
  COMPLETED
  FAILED
  CANCELLED
  PAUSED
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ DELIVERY EVENT â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model DeliveryEvent {
  id              String   @id @default(cuid())
  orderId         String   @map("order_id")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  panelId         String?  @map("panel_id")
  panel           Panel?   @relation(fields: [panelId], references: [id], onDelete: SetNull)

  viewsBatch      Int      @map("views_batch")
  scheduledAt     DateTime @map("scheduled_at")
  executedAt      DateTime? @map("executed_at")
  status          EventStatus @default(SCHEDULED)
  responseData    Json?    @map("response_data")
  errorMessage    String?  @map("error_message")

  createdAt       DateTime @default(now()) @map("created_at")

  @@map("delivery_events")
}

enum EventStatus {
  SCHEDULED
  EXECUTING
  DONE
  FAILED
  RETRYING
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ SUBSCRIPTION â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeCustomerId  String?  @map("stripe_customer_id")
  stripePaymentId   String?  @map("stripe_payment_id")
  amount            Int?     // in cents ($20 = 2000)
  currency          String   @default("usd")
  status            SubStatus @default(ACTIVE)

  paidAt            DateTime? @map("paid_at")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("subscriptions")
}

enum SubStatus {
  ACTIVE
  CANCELLED
  REFUNDED
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ AUDIT LOG â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  metadata  Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ ADMIN SETTINGS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model AdminSettings {
  id              String   @id @default("global")
  trc20Address    String?  @map("trc20_address")
  bep20Address    String?  @map("bep20_address")
  priceUsdt       Float    @default(20.0) @map("price_usdt")
  siteName        String   @default("YoyoSMM") @map("site_name")
  maintenanceMode Boolean  @default(false) @map("maintenance_mode")
  freeTrialHours  Int      @default(24) @map("free_trial_hours")
  supportEmail    String?  @map("support_email")
  upiId           String?  @map("upi_id")
  upiQrCode       String?  @map("upi_qr_code")
  minDeposit      Float    @default(500.0) @map("min_deposit")
  apifyKeys       String?  @map("apify_keys") @db.Text
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("admin_settings")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ CRYPTO PAYMENT â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model CryptoPayment {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  network         CryptoNetwork
  walletAddress   String        @map("wallet_address")
  txHash          String        @unique @map("tx_hash")
  amountUsdt      Float?        @map("amount_usdt")
  status          PaymentStatus @default(PENDING)
  verifiedAt      DateTime?     @map("verified_at")
  verifyAttempts  Int           @default(0) @map("verify_attempts")
  verifyError     String?       @map("verify_error")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("crypto_payments")
}

enum CryptoNetwork {
  TRC20
  BEP20
}

enum PaymentStatus {
  PENDING
  VERIFYING
  CONFIRMED
  FAILED
  REJECTED
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ SERVICE CONFIG â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model ServiceConfig {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  panelId     String   @map("panel_id")
  panel       Panel    @relation(fields: [panelId], references: [id], onDelete: Cascade)
  platform    Platform
  serviceId   String   @map("service_id")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, panelId, platform])
  @@map("service_configs")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ CURVE TEMPLATE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model CurveTemplate {
  id              String      @id @default(cuid())
  userId          String      @map("user_id")
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  style           CurveStyle  @default(ORGANIC) @map("curve_style")
  durationHours   Int         @default(24) @map("duration_hours")
  warmupHours     Int         @default(4) @map("warmup_hours")
  peakHours       Int         @default(8) @map("peak_hours")
  decayHours      Int         @default(12) @map("decay_hours")
  
  // Default engagement ratios (stored as percentages)
  likesRatioPct   Float       @default(4.0) @map("likes_ratio_pct")
  savesRatioPct   Float       @default(2.0) @map("saves_ratio_pct")
  sharesRatioPct  Float       @default(0.5) @map("shares_ratio_pct")
  commentsRatioPct Float      @default(0.2) @map("comments_ratio_pct")
  repostsRatioPct Float       @default(0.0) @map("reposts_ratio_pct")
  
  autoSubscriptions AutoSubscription[]
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("curve_templates")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ UPI PAYMENT â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model UpiPayment {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  utr            String        @unique
  amount         Float
  status         PaymentStatus @default(PENDING)
  rejectedReason String?       @map("rejected_reason")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("upi_payments")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ ADMIN SERVICE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model AdminService {
  id           String   @id @default(cuid())
  panelId      String   @map("panel_id")
  panel        Panel    @relation(fields: [panelId], references: [id], onDelete: Cascade)
  platform     Platform
  type         String   // "views", "likes", "saves", "shares", "comments"
  serviceId    String   @map("service_id") // Primary SMM service ID
  // Ordered list of fallback service IDs to try if primary fails.
  // e.g. ["13840", "5215"] — tried in order before giving up.
  fallbackServiceIds Json? @default("[]") @map("fallback_service_ids")
  originalRate Float    @map("original_rate") // rate per 1000 from SMM API
  customRate   Float    @map("custom_rate") // custom rate per 1000 charged to user (always = originalRate × 5)
  name         String?  // name of service from SMM API for reference
  minQuantity  Int      @default(10) @map("min_quantity")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([panelId, platform, type])
  @@map("admin_services")
}

model ServiceChangeLog {
  id              String   @id @default(cuid())
  panelId         String   @map("panel_id")
  panel           Panel    @relation(fields: [panelId], references: [id], onDelete: Cascade)
  platform        Platform
  type            String   // "views", "likes", etc.
  oldServiceId    String   @map("old_service_id")
  newServiceId    String   @map("new_service_id")
  oldServiceName  String?  @map("old_service_name")
  newServiceName  String?  @map("new_service_name")
  reason          String
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("service_change_logs")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ SUPPORT TICKET â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model SupportTicket {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  status    String          @default("OPEN") // "OPEN", "RESOLVED", "CLOSED", "ANSWERED"
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  messages  TicketMessage[]

  @@map("support_tickets")
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String        @map("ticket_id")
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    String        // "USER" or "ADMIN"
  message   String
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("ticket_messages")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ AFFILIATE TRANSACTION â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model AffiliateTransaction {
  id               String   @id @default(cuid())
  affiliateId      String   @map("affiliate_id")
  affiliate        User     @relation("AffiliateEarnings", fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId   String   @map("referred_user_id")
  referredUser     User     @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  amountDeposit    Float    @map("amount_deposit")
  commissionEarned Float    @map("commission_earned")
  type             String   @default("DEPOSIT")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("affiliate_transactions")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ AUTO SUBSCRIPTION â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model AutoSubscription {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId  String?  @map("template_id") // Kept for backward compatibility
  templateIds String[] @default([]) @map("template_ids")
  template    CurveTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  platform    String   @default("INSTAGRAM") // "INSTAGRAM", "TIKTOK", "FACEBOOK"
  username    String
  lastPostId  String?  @map("last_post_id")
  status      String   @default("ACTIVE") // "ACTIVE", "PAUSED", "INSUFFICIENT_FUNDS"
  viewsTarget Int      @default(0) @map("views_target") // Kept for backward compatibility
  viewsMin    Int      @default(1000) @map("views_min")
  viewsMax    Int      @default(5000) @map("views_max")
  
  likesMin    Int      @default(0) @map("likes_min")
  likesMax    Int      @default(0) @map("likes_max")
  commentsMin Int      @default(0) @map("comments_min")
  commentsMax Int      @default(0) @map("comments_max")
  sharesMin   Int      @default(0) @map("shares_min")
  sharesMax   Int      @default(0) @map("shares_max")
  savesMin    Int      @default(0) @map("saves_min")
  savesMax    Int      @default(0) @map("saves_max")
  repostsMin  Int      @default(0) @map("reposts_min")
  repostsMax  Int      @default(0) @map("reposts_max")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("auto_subscriptions")
}

model Blog {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  readTime  String
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("blogs")
}

// ─────────────── PROFIT SPLIT ───────────────
model ProfitSplit {
  id          String   @id @default(cuid())
  paymentId   String?  @map("payment_id")
  source      String   // "UPI" or "CRYPTO"
  amountInr   Float    @map("amount_inr")
  ankitShare  Float    @map("ankit_share")
  ramShare    Float    @map("ram_share")
  isSettled   Boolean  @default(false) @map("is_settled")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("profit_splits")
}
